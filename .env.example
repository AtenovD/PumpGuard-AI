BOT_TOKEN=123456:your-telegram-bot-token
ADMIN_IDS=123456789
DB_PATH=pumpguard.db
DASHBOARD_PORT=8000

# Model API — used only for the 4 screening agents, never to place trades.
# Defaults to xAI Grok; any OpenAI-compatible chat-completions API works:
# set GROK_API_KEY, GROK_BASE_URL and the two model names to your provider's values.
GROK_API_KEY=your-api-key-here
GROK_BASE_URL=https://api.x.ai/v1/chat/completions
GROK_FAST_MODEL=grok-4-fast
GROK_CHECKER_MODEL=grok-4
GROK_TIMEOUT_SECONDS=20
GROK_MAX_RETRIES=3

# Optional: per-user Grok OAuth for the "Ask Grok" signal button.
XAI_OAUTH_CLIENT_ID=
XAI_OAUTH_CLIENT_SECRET=
XAI_OAUTH_REDIRECT_URI=https://your-dashboard.example.com/oauth/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=

ENABLED_CHAINS=robinhood
ROBINHOOD_DATA_URL=https://hood.fun
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
MIN_LAUNCH_AGE_SECONDS=60
# A token older than this is never treated as a new launch (protects the paid pipeline
# if the indexer ever serves a different or larger dataset).
MAX_LAUNCH_AGE_SECONDS=3600
# How often the hood.fun board is polled. Raise it to reduce bandwidth.
ROBINHOOD_POLL_SECONDS=5
MIN_UNIQUE_BUYERS=5
COPYCAT_SIMILARITY_THRESHOLD=0.85

# Risk manager. Amounts are ETH (the chain's native currency).
# The pre-1.1 names MAX_SOL_PER_TRADE / DAILY_LOSS_LIMIT_SOL still work if set.
MAX_ETH_PER_TRADE=0.5
DAILY_LOSS_LIMIT_ETH=2.0
MAX_TOTAL_EXPOSURE_ETH=1.5
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=5
STOP_LOSS_PCT=35

# Exit scheme (percentages are net of fees and price impact). See docs/simulation-model.md
# ROI_TABLE is "minutes:min-profit-%" pairs: after N minutes, take at least that profit.
ROI_TABLE=0:100,30:40,120:15,360:0
TRAILING_ACTIVATE_PCT=25
TRAILING_STOP_PCT=12
MAX_HOLD_MINUTES=720

# Protections: pause new entries after this many stop-losses inside the window.
# Set PROTECT_STOPLOSS_LIMIT=0 to disable.
PROTECT_STOPLOSS_LIMIT=3
PROTECT_WINDOW_MINUTES=240
PROTECT_LOCK_MINUTES=120

# Flat per-side cost used when a token has no bonding curve (graduated tokens).
FALLBACK_COST_BPS=100

# Reputation book
RUG_LOSS_PCT=60
BLOCK_CREATOR_AFTER_RUGS=1
FORGET_CREATORS_AFTER_DAYS=90

# Optional: channel/group the bot posts every passing signal to
ALERT_CHAT_ID=
# Optional comma-separated HTTPS endpoints receiving schema-versioned passing signals.
WEBHOOK_URLS=
# Optional: separate public channel for the weekly recorded-performance summary.
PUBLIC_DIGEST_CHAT_ID=

# Optional: NFT screener - a second, independent screening pipeline for Robinhood
# Chain NFT collections. Alert-only, no dry-run buy/sell (NFTs have no bonding-curve
# entry price). Off by default.
NFT_SCREENER_ENABLED=false
ROBINHOOD_NFT_DATA_URL=https://hood.fun
NFT_MIN_LAUNCH_AGE_SECONDS=60
NFT_MIN_UNIQUE_MINTERS=5
# Optional: separate channel for NFT alerts; falls back to ALERT_CHAT_ID if unset.
NFT_ALERT_CHAT_ID=
# Floor-sweep watcher thresholds (percent move from a collection's first-observed floor).
FLOOR_SWEEP_DROP_PCT=40
FLOOR_SWEEP_PUMP_PCT=100
